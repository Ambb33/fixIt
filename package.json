{
  "name": "hoobnk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build ",
    "start": "node .next/standalone/server.js",
    "stop": "pm2 stop all",
