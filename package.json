    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.11.7",
    "http-proxy-middleware": "^3.0.3",
    "next": "^15.2.0",
    "nodemailer": "^6.9.15",
    "postcss": "8.4.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-modal": "^3.16.1",
    "tailwindcss": "3.3.2",
    "typescript": "5.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react-modal": "^3.16.3",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
